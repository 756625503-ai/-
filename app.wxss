page {
  min-height: 100%;
  background: #efefef;
  color: #1d2b3a;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 1.4;
}

button::after {
  border: none;
}

button:active,
.primary-button:active,
.secondary-button:active,
.danger-button:active {
  opacity: 0.82;
}

button[disabled] {
  opacity: 0.48;
}

.page {
  padding: 28rpx;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #38535b;
  font-size: 30rpx;
  font-weight: 700;
}

.card {
  padding: 28rpx;
  border: 1rpx solid #dfe8ea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(41, 75, 84, 0.06);
}

.muted {
  color: #667085;
}

.empty {
  padding: 40rpx 24rpx;
  border: 1rpx dashed #b8d6de;
  border-radius: 16rpx;
  color: #63767c;
  text-align: center;
  background: #ffffff;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.primary-button {
  color: #173f48;
  background: #72b0be;
}

.secondary-button {
  color: #315f6a;
  background: #cde9f2;
}

.danger-button {
  color: #b42318;
  background: #fff1f0;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 700;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d3e0e3;
  border-radius: 12rpx;
  color: #1d2b3a;
  background: #ffffff;
  font-size: 30rpx;
}

.textarea {
  min-height: 148rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #315f6a;
  background: #cde9f2;
  font-size: 24rpx;
  font-weight: 700;
}

.pill-green {
  color: #355d3f;
  background: #d6ebb4;
}

.pill-amber {
  color: #b54708;
  background: #fffaeb;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.safe-bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
