.records-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: #efefef;
}

.records-header {
  padding: 34rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  color: #ffffff;
  background: #72b0be;
}

.person-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.person-copy {
  flex: 1;
  min-width: 0;
}

.greeting,
.person-name {
  display: block;
}

.greeting {
  margin-bottom: 6rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  opacity: 0.76;
}

.person-name {
  max-width: 100%;
  overflow: hidden;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-box {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 0 26rpx;
  border: 1rpx solid #cde9f2;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(41, 75, 84, 0.08);
}

.search-input {
  flex: 1;
  height: 88rpx;
  color: #344054;
  font-size: 29rpx;
}

.search-icon {
  flex: 0 0 auto;
  color: #5b8792;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
}

.compare-entry {
  display: flex;
  width: 156rpx;
  min-width: 156rpx;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b6dbe4;
  border-radius: 999rpx;
  color: #315f6a;
  background: #cde9f2;
  font-size: 25rpx;
  font-weight: 800;
}

.timeline-scroll {
  height: calc(100vh - 318rpx - env(safe-area-inset-bottom));
}

.timeline {
  position: relative;
  min-height: 100%;
  padding: 36rpx 34rpx 64rpx;
}

.timeline-add {
  position: relative;
  display: flex;
  height: 82rpx;
  align-items: center;
  justify-content: center;
}

.timeline-add::before,
.timeline-row::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  z-index: 0;
  width: 2rpx;
  transform: translateX(-1rpx);
  background: #72b0be;
  content: "";
}

.timeline-plus {
  position: relative;
  z-index: 2;
  display: flex;
  width: 70rpx;
  height: 70rpx;
  min-width: 70rpx;
  min-height: 70rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #72b0be;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.timeline-row {
  position: relative;
  display: grid;
  grid-template-columns: calc(50% - 18rpx) 36rpx calc(50% - 18rpx);
  min-height: 170rpx;
  align-items: center;
}

.timeline-row-last::before {
  bottom: 50%;
}

.date-bubble {
  position: relative;
  z-index: 1;
  display: flex;
  box-sizing: border-box;
  width: 224rpx;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  justify-self: end;
  margin-right: 10rpx;
  padding: 0 22rpx;
  border: 1rpx solid #a6d2dc;
  border-radius: 16rpx;
  color: #1f4f5b;
  background: #72b0be;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(67, 119, 130, 0.16);
}

.date-bubble::after {
  position: absolute;
  top: 50%;
  right: -28rpx;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 28rpx solid #72b0be;
  transform: translateY(-50%);
  content: "";
}

.node {
  position: relative;
  z-index: 2;
  width: 20rpx;
  height: 20rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #72b0be;
  border: 6rpx solid #efefef;
  box-shadow: 0 0 0 2rpx #72b0be;
}

.record-brief {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 94%;
  min-width: 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dfe8ea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(41, 75, 84, 0.07);
}

.record-brief::before {
  position: absolute;
  top: 50%;
  left: -18rpx;
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-right: 18rpx solid #ffffff;
  transform: translateY(-50%);
  content: "";
}

.brief-title,
.brief-meta {
  display: block;
}

.brief-title {
  overflow: hidden;
  color: #28434a;
  font-size: 36rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brief-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #71858b;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-bubble.event-health {
  color: #243b31;
  background: #d6ebb4;
  box-shadow: 0 10rpx 22rpx rgba(84, 112, 66, 0.14);
}

.date-bubble.event-health::after {
  border-left-color: #d6ebb4;
}

.node.event-health {
  background: #d6ebb4;
  box-shadow: 0 0 0 2rpx #d6ebb4;
}

.record-brief.event-health {
  border-color: #d6ebb4;
  background: #ffffff;
}

.record-brief.event-health::before {
  border-right-color: #ffffff;
}

.record-brief.event-health .brief-title {
  color: #243b31;
}

.record-brief.event-health .brief-meta {
  color: #71858b;
}

.date-bubble.event-primary {
  color: #1f4f5b;
  background: #72b0be;
}

.date-bubble.event-primary::after {
  border-left-color: #72b0be;
}

.node.event-primary {
  background: #72b0be;
}

.record-brief.event-primary {
  border-color: #dfe8ea;
  background: #ffffff;
}

.record-brief.event-primary::before {
  border-right-color: #ffffff;
}

.empty-timeline {
  position: relative;
  z-index: 2;
  margin-top: 80rpx;
  color: #71858b;
  font-size: 28rpx;
  text-align: center;
}
