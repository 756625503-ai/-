.records-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
}

.records-header {
  padding: 34rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  color: #ffffff;
  background: #19b9a7;
}

.person-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.greeting,
.person-name {
  display: block;
}

.greeting {
  margin-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  font-weight: 700;
}

.person-name {
  max-width: 470rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-add {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: rgba(4, 104, 98, 0.36);
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.member-scroll {
  width: 100%;
  margin-top: 26rpx;
  white-space: nowrap;
}

.member-row {
  display: flex;
  gap: 12rpx;
}

.member-chip {
  display: inline-flex;
  min-width: 104rpx;
  min-height: 56rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  color: #ffffff;
  background: transparent;
  font-size: 25rpx;
  font-weight: 700;
}

.member-active {
  color: #0d6f67;
  background: #ffffff;
}

.search-box {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 0 26rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.search-input {
  flex: 1;
  height: 88rpx;
  color: #344054;
  font-size: 29rpx;
}

.search-icon {
  flex: 0 0 auto;
  color: #475467;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
}

.timeline-scroll {
  height: calc(100vh - 330rpx - env(safe-area-inset-bottom));
}

.timeline {
  position: relative;
  min-height: 100%;
  padding: 44rpx 34rpx 64rpx;
}

.timeline::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 334rpx;
  width: 2rpx;
  background: #58beb4;
  content: "";
}

.timeline-add {
  position: relative;
  display: flex;
  height: 82rpx;
  align-items: center;
  justify-content: center;
}

.timeline-plus {
  position: relative;
  z-index: 2;
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #22b9aa;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.timeline-row {
  position: relative;
  display: grid;
  grid-template-columns: 282rpx 36rpx 1fr;
  min-height: 170rpx;
  align-items: center;
}

.date-bubble {
  position: relative;
  display: flex;
  width: 242rpx;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #159185;
  font-size: 30rpx;
  font-weight: 700;
}

.date-bubble::after {
  position: absolute;
  right: 26rpx;
  bottom: -18rpx;
  width: 0;
  height: 0;
  border-top: 20rpx solid #159185;
  border-left: 44rpx solid transparent;
  content: "";
}

.node {
  position: relative;
  z-index: 2;
  width: 20rpx;
  height: 20rpx;
  margin-left: 9rpx;
  border-radius: 50%;
  background: #159185;
}

.record-brief {
  min-width: 0;
  padding-left: 22rpx;
  border-bottom: 3rpx solid #159185;
}

.brief-title,
.brief-meta {
  display: block;
}

.brief-title {
  overflow: hidden;
  color: #159185;
  font-size: 36rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brief-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #6baaa4;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-bubble.event-purple {
  background: #8b5cf6;
}

.date-bubble.event-purple::after {
  border-top-color: #8b5cf6;
}

.node.event-purple {
  background: #8b5cf6;
}

.record-brief.event-purple {
  border-bottom-color: #8b5cf6;
}

.record-brief.event-purple .brief-title {
  color: #7c3aed;
}

.record-brief.event-purple .brief-meta {
  color: #9b7bd9;
}

.date-bubble.event-green {
  background: #159185;
}

.date-bubble.event-green::after {
  border-top-color: #159185;
}

.node.event-green {
  background: #159185;
}

.record-brief.event-green {
  border-bottom-color: #159185;
}

.empty-timeline {
  position: relative;
  z-index: 2;
  margin: 80rpx 0 0 338rpx;
  color: #98a2b3;
  font-size: 28rpx;
}
