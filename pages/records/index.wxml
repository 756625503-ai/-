<view class="page safe-bottom">
  <view class="row list-head">
    <view>
      <text class="page-title">记录列表</text>
      <text class="page-meta">共 {{filteredRecords.length}} 条</text>
    </view>
    <button class="add-button" bindtap="goAdd">新增</button>
  </view>

  <view class="search-wrap">
    <input class="search-input" value="{{keyword}}" bindinput="onSearch" placeholder="搜索医院、诊断、药名" />
  </view>

  <scroll-view scroll-x class="filter-scroll">
    <view class="filter-row">
      <button
        class="filter-chip {{activeType === item ? 'filter-active' : ''}}"
        wx:for="{{filterOptions}}"
        wx:key="*this"
        data-type="{{item}}"
        bindtap="changeFilter"
      >
        {{item}}
      </button>
    </view>
  </scroll-view>

  <block wx:if="{{filteredRecords.length}}">
    <view
      class="record-card"
      wx:for="{{filteredRecords}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openRecord"
    >
      <view class="record-head">
        <text class="pill {{item.type === '处方' ? 'pill-amber' : item.type === '体检' ? 'pill-green' : ''}}">{{item.type}}</text>
        <text class="record-date">{{item.displayDate}}</text>
      </view>
      <text class="record-title">{{item.displayTitle}}</text>
      <text class="record-line">{{item.hospital || '未填写医院'}} {{item.department || ''}} {{item.doctor || ''}}</text>
      <text wx:if="{{item.diagnosis || item.summary}}" class="record-summary">{{item.diagnosis || item.summary}}</text>
      <view wx:if="{{item.files.length}}" class="file-count">{{item.files.length}} 个附件</view>
    </view>
  </block>

  <view wx:else class="empty">暂无匹配记录</view>
</view>
