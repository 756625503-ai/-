<view class="records-page">
  <view class="records-header">
    <view class="person-row">
      <view>
        <text class="greeting">健康记录</text>
        <text class="person-name">{{activeProfileName}}</text>
      </view>
      <button class="header-add" bindtap="goAdd">+</button>
    </view>

    <scroll-view scroll-x class="member-scroll">
      <view class="member-row">
        <button
          class="member-chip {{activeProfileId === item.id ? 'member-active' : ''}}"
          wx:for="{{profiles}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="changeProfile"
        >
          {{item.displayName}}
        </button>
      </view>
    </scroll-view>

    <view class="search-box">
      <input class="search-input" value="{{keyword}}" bindinput="onSearch" placeholder="搜索医院、检查报告、ct胶片、药物..." />
      <text class="search-icon">⌕</text>
    </view>
  </view>

  <scroll-view scroll-y class="timeline-scroll">
    <view class="timeline">
      <view class="timeline-add">
        <button class="timeline-plus" bindtap="goAdd">+</button>
      </view>

      <block wx:if="{{filteredRecords.length}}">
        <view
          class="timeline-row"
          wx:for="{{filteredRecords}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openRecord"
        >
          <view class="date-bubble {{item.themeClass}}">
            <text>{{item.displayDate}}</text>
          </view>
          <view class="node {{item.themeClass}}"></view>
          <view class="record-brief {{item.themeClass}}">
            <text class="brief-title">{{item.timelineTitle}}</text>
            <text class="brief-meta">{{item.timelineMeta}}</text>
          </view>
        </view>
      </block>

      <view wx:else class="empty-timeline">
        <text>暂无匹配记录</text>
      </view>
    </view>
  </scroll-view>
</view>
