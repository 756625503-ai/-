.profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.profile-name,
.profile-meta {
  display: block;
}

.profile-name {
  color: #1d2b3a;
  font-size: 38rpx;
  font-weight: 800;
}

.profile-meta {
  margin-top: 12rpx;
  color: #71858b;
  font-size: 25rpx;
}

.advice-card {
  margin-bottom: 16rpx;
  padding: 26rpx;
  border: 1rpx solid #b9dce5;
  border-radius: 16rpx;
  background: #cde9f2;
  box-shadow: 0 8rpx 18rpx rgba(67, 119, 130, 0.07);
}

.advice-title,
.advice-text {
  display: block;
}

.advice-title {
  color: #315f6a;
  font-size: 29rpx;
  font-weight: 800;
}

.advice-text {
  margin-top: 12rpx;
  color: #29444c;
  font-size: 26rpx;
  line-height: 1.55;
}
