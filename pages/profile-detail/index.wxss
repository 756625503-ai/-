.profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-name,
.profile-meta {
  display: block;
}

.profile-name {
  color: #101828;
  font-size: 38rpx;
  font-weight: 800;
}

.profile-meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
}

.advice-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #d1e9ff;
  border-radius: 8rpx;
  background: #f5fbff;
}

.advice-title,
.advice-text {
  display: block;
}

.advice-title {
  color: #175cd3;
  font-size: 29rpx;
  font-weight: 800;
}

.advice-text {
  margin-top: 12rpx;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.55;
}
