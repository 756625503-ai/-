<view class="page safe-bottom">
  <view class="card edit-head">
    <view>
      <text class="edit-title">{{isEditing ? '编辑健康记录' : '新增健康记录'}}</text>
      <text class="edit-meta">{{record.type}} · {{record.visitDate}}</text>
    </view>
  </view>

  <view class="type-priority">
    <view class="type-priority-head">
      <view>
        <text class="priority-label">记录类型</text>
      </view>
      <view class="type-current {{typeThemeClass}}">
        <text>{{record.type}}</text>
      </view>
    </view>
    <view class="type-group" wx:for="{{typeGroups}}" wx:for-item="group" wx:key="label">
      <text class="group-label">{{group.label}}</text>
      <view class="type-chip-rows">
        <view class="type-chip-row type-chip-row--{{group.rowColumns}}" wx:for="{{group.rows}}" wx:for-item="row" wx:key="key">
          <button
            class="type-chip {{group.themeClass}} {{record.type === item.value ? 'type-active' : ''}}"
            wx:for="{{row.items}}"
            wx:for-item="item"
            wx:key="value"
            data-type="{{item.value}}"
            bindtap="onTypeTap"
          >
            <text class="type-icon">{{item.icon}}</text>
            <text class="type-name">{{item.value}}</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="attachment-panel">
    <view class="attachment-head">
      <view>
        <text class="attachment-title">上传附件</text>
        <text class="attachment-count">{{record.files.length}}/{{maxAttachments}}</text>
      </view>
      <view class="attachment-add" bindtap="chooseAttachment">+</view>
    </view>

    <scroll-view wx:if="{{record.files.length}}" scroll-x class="attachment-scroll">
      <view class="attachment-strip">
        <view
          class="attachment-card"
          wx:for="{{record.files}}"
          wx:key="path"
          data-index="{{index}}"
        >
          <view class="attachment-preview" data-index="{{index}}" bindtap="previewAttachment">
            <image wx:if="{{item.type === 'image'}}" class="attachment-image" src="{{item.path}}" mode="aspectFill" />
            <view wx:elif="{{item.type === 'video'}}" class="attachment-video-wrap">
              <image wx:if="{{item.poster}}" class="attachment-image" src="{{item.poster}}" mode="aspectFill" />
              <view wx:else class="attachment-file attachment-video-fallback">
                <text class="file-badge">VIDEO</text>
                <text class="file-card-name">{{item.name}}</text>
              </view>
              <view class="video-play">▶</view>
            </view>
            <view wx:else class="attachment-file">
              <text class="file-badge">FILE</text>
              <text class="file-card-name">{{item.name}}</text>
            </view>
          </view>
          <input
            class="attachment-name-input"
            value="{{item.title}}"
            data-index="{{index}}"
            bindinput="onAttachmentTitleInput"
            placeholder="输入附件名称"
          />
          <picker mode="date" value="{{item.date}}" data-index="{{index}}" bindchange="onAttachmentDateChange">
            <view class="attachment-date">— {{item.date}} —</view>
          </picker>
          <view class="ocr-panel">
            <view class="ocr-head">
              <text class="ocr-title">附件内容</text>
              <text class="ocr-status">{{item.ocrStatusText}}</text>
            </view>
            <textarea
              wx:if="{{item.ocrText}}"
              class="ocr-textarea"
              value="{{item.ocrText}}"
              data-index="{{index}}"
              bindinput="onAttachmentOcrInput"
              placeholder="识别出的报告文字"
            />
            <text wx:else class="ocr-empty">{{item.canRecognize ? '点击识别后自动提取报告文字' : '当前附件暂不支持自动识别'}}</text>
          </view>
          <view class="attachment-actions">
            <button
              wx:if="{{item.canRecognize}}"
              class="attachment-ocr"
              disabled="{{item.ocrStatus === 'recognizing'}}"
              data-index="{{index}}"
              catchtap="recognizeAttachment"
            >
              识别内容
            </button>
            <button class="attachment-delete" data-index="{{index}}" catchtap="removeAttachment">删除</button>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="attachment-empty" bindtap="chooseAttachment">
      <view class="empty-plus">+</view>
      <text>添加报告、处方、检查图片或文件</text>
    </view>
  </view>

  <view class="section">
    <view class="field">
      <text class="field-label">家庭成员</text>
      <picker mode="selector" range="{{profileNames}}" value="{{profileIndex}}" bindchange="onProfileChange">
        <view class="picker-value">{{activeProfileName}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">日期</text>
      <picker mode="date" value="{{record.visitDate}}" bindchange="onDateChange">
        <view class="picker-value">{{record.visitDate}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">标题</text>
      <input class="input" value="{{record.title}}" data-field="title" bindinput="onInput" placeholder="例如：年度体检、心内科门诊" />
    </view>
    <view class="field">
      <text class="field-label">主要情况</text>
      <textarea class="textarea" value="{{record.summary}}" data-field="summary" bindinput="onInput" placeholder="症状、体检异常项、检查原因" />
    </view>
    <view class="field">
      <text class="field-label">诊断结果</text>
      <textarea class="textarea" value="{{record.diagnosis}}" data-field="diagnosis" bindinput="onInput" placeholder="医生诊断或报告结论" />
    </view>
    <view class="field">
      <text class="field-label">药方 / 用药</text>
      <textarea class="textarea" value="{{record.medicines}}" data-field="medicines" bindinput="onInput" placeholder="药名、剂量、频次、疗程" />
    </view>
    <view class="field">
      <text class="field-label">医生建议</text>
      <textarea class="textarea" value="{{record.advice}}" data-field="advice" bindinput="onInput" placeholder="复查、复诊、饮食、运动等建议" />
    </view>
  </view>

  <view class="action-bar">
    <button wx:if="{{isEditing}}" class="danger-button" bindtap="deleteRecord">删除</button>
    <button class="primary-button" bindtap="saveRecord">保存记录</button>
  </view>
</view>
