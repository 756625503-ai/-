.edit-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.edit-title,
.edit-meta {
  display: block;
}

.edit-title {
  color: #101828;
  font-size: 38rpx;
  font-weight: 800;
}

.edit-meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
}

.pill-green {
  color: #067647;
  background: #ecfdf3;
}

.pill-purple {
  color: #6d28d9;
  background: #f3e8ff;
}

.type-priority {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.priority-label,
.group-label {
  display: block;
}

.priority-label {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.type-group {
  margin-top: 22rpx;
}

.type-group + .type-group {
  padding-top: 22rpx;
  border-top: 1rpx solid #eef2f6;
}

.group-label {
  margin-bottom: 12rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
}

.type-chip-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.type-chip {
  display: flex;
  width: 100%;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.type-chip.type-green {
  color: #08756f;
  background: #e7f8f5;
}

.type-chip.type-purple {
  color: #7c3aed;
  background: #f3e8ff;
}

.type-chip.type-active.type-green {
  color: #ffffff;
  background: #159185;
  border-color: #0f766e;
}

.type-chip.type-active.type-purple {
  color: #ffffff;
  background: #8b5cf6;
  border-color: #7c3aed;
}

.small-button {
  min-width: 104rpx;
  min-height: 56rpx;
  color: #147d7e;
  background: #ecfdf3;
  font-size: 25rpx;
  font-weight: 700;
}

.file-item {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.file-name {
  flex: 1;
  color: #344054;
  font-size: 27rpx;
  word-break: break-all;
}

.file-remove {
  width: 96rpx;
  min-height: 52rpx;
  color: #b42318;
  background: #fff1f0;
  font-size: 24rpx;
}

.action-bar {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.danger-button + .primary-button {
  margin-top: 0;
}
