.edit-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.edit-title,
.edit-meta {
  display: block;
}

.edit-title {
  color: #101828;
  font-size: 38rpx;
  font-weight: 800;
}

.edit-meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
}

.pill-green {
  color: #067647;
  background: #ecfdf3;
}

.pill-purple {
  color: #6d28d9;
  background: #f3e8ff;
}

.type-priority {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 30rpx 30rpx 34rpx;
  border: 2rpx solid #c7eadc;
  border-radius: 28rpx;
  background: #e4f6ee;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}

.priority-label,
.group-label,
.type-name {
  display: block;
}

.type-priority-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.type-priority-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.priority-label {
  color: #1d2b3a;
  font-size: 32rpx;
  font-weight: 800;
}

.type-current {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  max-width: 190rpx;
  min-width: 132rpx;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-current text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-group {
  margin-top: 30rpx;
}

.type-group + .type-group {
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.7);
}

.group-label {
  margin-bottom: 20rpx;
  color: #335f4f;
  font-size: 28rpx;
  font-weight: 800;
}

.type-chip-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.type-chip-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.type-chip-row--2 .type-chip,
.type-chip-row--3 .type-chip {
  flex: 0 0 49%;
  width: 49%;
  max-width: 49%;
}

.type-chip {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  height: 76rpx;
  min-height: 76rpx;
  align-items: center;
  gap: 16rpx;
  margin: 0;
  overflow: hidden;
  padding: 0 20rpx;
  border: 1rpx solid rgba(209, 246, 231, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 8rpx 18rpx rgba(20, 125, 126, 0.12);
  line-height: 1.2;
  text-align: left;
}

.type-chip::after {
  border: 0;
}

.type-icon {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 900;
}

.type-name {
  overflow: hidden;
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-chip.type-green {
  border-color: rgba(255, 255, 255, 0.72);
}

.type-chip.type-purple {
  border-color: rgba(255, 255, 255, 0.72);
}

.type-chip.type-green .type-icon {
  color: #08756f;
  background: #e7f8f5;
}

.type-chip.type-purple .type-icon {
  color: #7c3aed;
  background: #f3e8ff;
}

.attachment-panel {
  margin-top: 24rpx;
  padding: 26rpx 0 30rpx;
  border: 1rpx solid #eef2f6;
  border-radius: 8rpx;
  background: #ffffff;
}

.attachment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 26rpx;
}

.attachment-title,
.attachment-count,
.attachment-date {
  display: block;
}

.attachment-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.attachment-count {
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 28rpx;
  font-weight: 700;
}

.attachment-add,
.empty-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #22b9aa;
  font-weight: 300;
  line-height: 1;
}

.attachment-add {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  font-size: 58rpx;
}

.attachment-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.attachment-strip {
  display: flex;
  gap: 24rpx;
  padding: 0 26rpx;
}

.attachment-card {
  flex: 0 0 auto;
  width: 520rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(16, 24, 40, 0.08);
}

.attachment-delete,
.attachment-ocr {
  display: flex;
  flex: 1;
  width: auto;
  min-width: 0;
  height: 52rpx;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid #fecdca;
  border-radius: 999rpx;
  color: #b42318;
  background: #fff5f5;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.attachment-ocr {
  border-color: #b7ebe5;
  color: #147d7e;
  background: #e7f8f5;
}

.attachment-delete::after,
.attachment-ocr::after {
  border: 0;
}

.attachment-preview {
  width: 100%;
  height: 430rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: #f2f4f7;
}

.attachment-image {
  display: block;
  width: 100%;
  height: 100%;
}

.attachment-video-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.attachment-video-fallback {
  height: 100%;
}

.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  color: #ffffff;
  background: rgba(17, 24, 39, 0.42);
  font-size: 58rpx;
  line-height: 1;
  text-indent: 6rpx;
}

.attachment-file {
  display: flex;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  padding: 30rpx;
}

.file-badge {
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  color: #175cd3;
  background: #eaf2ff;
  font-size: 24rpx;
  font-weight: 800;
}

.file-card-name {
  width: 100%;
  color: #344054;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
  word-break: break-all;
}

.attachment-name-input {
  width: 100%;
  height: 58rpx;
  min-height: 58rpx;
  margin-top: 30rpx;
  color: #344054;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}

.attachment-date {
  margin-top: 26rpx;
  color: #98a2b3;
  font-size: 28rpx;
  text-align: center;
}

.ocr-panel {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #f9fafb;
}

.ocr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ocr-title,
.ocr-status,
.ocr-empty {
  display: block;
}

.ocr-title {
  color: #344054;
  font-size: 25rpx;
  font-weight: 800;
}

.ocr-status {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #147d7e;
  background: #e7f8f5;
  font-size: 23rpx;
  font-weight: 800;
}

.ocr-textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #eef2f6;
  border-radius: 8rpx;
  color: #344054;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 1.5;
}

.ocr-empty {
  margin-top: 14rpx;
  color: #98a2b3;
  font-size: 24rpx;
  line-height: 1.45;
}

.attachment-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.attachment-empty {
  display: flex;
  min-height: 210rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 24rpx 26rpx 0;
  border: 2rpx dashed #b7ebe5;
  border-radius: 8rpx;
  color: #667085;
  background: #f7fffd;
  font-size: 26rpx;
}

.empty-plus {
  width: 72rpx;
  height: 72rpx;
  font-size: 58rpx;
}

.action-bar {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.danger-button + .primary-button {
  margin-top: 0;
}
