.edit-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.edit-title,
.edit-meta {
  display: block;
}

.edit-title {
  color: #101828;
  font-size: 38rpx;
  font-weight: 800;
}

.edit-meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
}

.pill-green {
  color: #067647;
  background: #ecfdf3;
}

.pill-purple {
  color: #6d28d9;
  background: #f3e8ff;
}

.type-priority {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.priority-label,
.group-label,
.type-name,
.type-hint {
  display: block;
}

.type-priority-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.type-priority-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.priority-label {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.type-current {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  max-width: 180rpx;
  min-width: 132rpx;
  min-height: 56rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-current text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-group {
  margin-top: 26rpx;
}

.type-group + .type-group {
  padding-top: 24rpx;
  border-top: 1rpx solid #eef2f6;
}

.group-label {
  margin-bottom: 14rpx;
  color: #475467;
  font-size: 25rpx;
  font-weight: 800;
}

.type-chip-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: 104rpx;
  align-items: stretch;
  justify-items: stretch;
  column-gap: 16rpx;
  row-gap: 16rpx;
  width: 100%;
}

.type-chip {
  position: relative;
  display: grid;
  box-sizing: border-box;
  grid-template-columns: 46rpx minmax(0, 1fr);
  width: calc(100% - 36rpx);
  min-width: 0;
  height: 100%;
  min-height: 0;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  overflow: hidden;
  padding: 16rpx;
  border: 2rpx solid #eef2f6;
  border-radius: 8rpx;
  background: #ffffff;
  line-height: 1.2;
  text-align: left;
}

.type-chip:nth-child(2n + 1) {
  justify-self: start;
}

.type-chip:nth-child(2n) {
  justify-self: end;
}

.type-chip.type-other {
  grid-column: 1 / 2;
  justify-self: start;
}

.type-chip::after {
  border: 0;
}

.type-icon {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  min-width: 46rpx;
  min-height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 900;
}

.type-copy {
  min-width: 0;
}

.type-name {
  overflow: hidden;
  color: #344054;
  font-size: 27rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-hint {
  margin-top: 8rpx;
  overflow: hidden;
  color: #98a2b3;
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-check {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.type-chip.type-green {
  border-color: #d0f2ee;
}

.type-chip.type-purple {
  border-color: #eadcff;
}

.type-chip.type-green .type-icon {
  color: #08756f;
  background: #e7f8f5;
}

.type-chip.type-purple .type-icon {
  color: #7c3aed;
  background: #f3e8ff;
}

.type-chip.type-active.type-green {
  background: #f3fffd;
  border-color: #0f766e;
  box-shadow: 0 10rpx 24rpx rgba(21, 145, 133, 0.12);
}

.type-chip.type-active.type-green .type-name {
  color: #08756f;
}

.type-chip.type-active.type-green .type-check,
.type-chip.type-active.type-green .type-icon {
  color: #ffffff;
  background: #159185;
}

.type-chip.type-active.type-purple {
  background: #fbf8ff;
  border-color: #7c3aed;
  box-shadow: 0 10rpx 24rpx rgba(139, 92, 246, 0.12);
}

.type-chip.type-active.type-purple .type-name {
  color: #7c3aed;
}

.type-chip.type-active.type-purple .type-check,
.type-chip.type-active.type-purple .type-icon {
  color: #ffffff;
  background: #8b5cf6;
}

.attachment-panel {
  margin-top: 24rpx;
  padding: 26rpx 0 30rpx;
  border: 1rpx solid #eef2f6;
  border-radius: 8rpx;
  background: #ffffff;
}

.attachment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 26rpx;
}

.attachment-title,
.attachment-count,
.attachment-date {
  display: block;
}

.attachment-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.attachment-count {
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 28rpx;
  font-weight: 700;
}

.attachment-add,
.empty-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #22b9aa;
  font-weight: 300;
  line-height: 1;
}

.attachment-add {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  font-size: 58rpx;
}

.attachment-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.attachment-strip {
  display: flex;
  gap: 24rpx;
  padding: 0 26rpx;
}

.attachment-card {
  flex: 0 0 auto;
  width: 520rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(16, 24, 40, 0.08);
}

.attachment-delete,
.attachment-ocr {
  display: flex;
  flex: 1;
  width: auto;
  min-width: 0;
  height: 52rpx;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid #fecdca;
  border-radius: 999rpx;
  color: #b42318;
  background: #fff5f5;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.attachment-ocr {
  border-color: #b7ebe5;
  color: #147d7e;
  background: #e7f8f5;
}

.attachment-delete::after,
.attachment-ocr::after {
  border: 0;
}

.attachment-preview {
  width: 100%;
  height: 430rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: #f2f4f7;
}

.attachment-image {
  display: block;
  width: 100%;
  height: 100%;
}

.attachment-video-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.attachment-video-fallback {
  height: 100%;
}

.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  color: #ffffff;
  background: rgba(17, 24, 39, 0.42);
  font-size: 58rpx;
  line-height: 1;
  text-indent: 6rpx;
}

.attachment-file {
  display: flex;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  padding: 30rpx;
}

.file-badge {
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  color: #175cd3;
  background: #eaf2ff;
  font-size: 24rpx;
  font-weight: 800;
}

.file-card-name {
  width: 100%;
  color: #344054;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
  word-break: break-all;
}

.attachment-name-input {
  width: 100%;
  height: 58rpx;
  min-height: 58rpx;
  margin-top: 30rpx;
  color: #344054;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}

.attachment-date {
  margin-top: 26rpx;
  color: #98a2b3;
  font-size: 28rpx;
  text-align: center;
}

.ocr-panel {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #f9fafb;
}

.ocr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ocr-title,
.ocr-status,
.ocr-empty {
  display: block;
}

.ocr-title {
  color: #344054;
  font-size: 25rpx;
  font-weight: 800;
}

.ocr-status {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #147d7e;
  background: #e7f8f5;
  font-size: 23rpx;
  font-weight: 800;
}

.ocr-textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #eef2f6;
  border-radius: 8rpx;
  color: #344054;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 1.5;
}

.ocr-empty {
  margin-top: 14rpx;
  color: #98a2b3;
  font-size: 24rpx;
  line-height: 1.45;
}

.attachment-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.attachment-empty {
  display: flex;
  min-height: 210rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 24rpx 26rpx 0;
  border: 2rpx dashed #b7ebe5;
  border-radius: 8rpx;
  color: #667085;
  background: #f7fffd;
  font-size: 26rpx;
}

.empty-plus {
  width: 72rpx;
  height: 72rpx;
  font-size: 58rpx;
}

.action-bar {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.danger-button + .primary-button {
  margin-top: 0;
}
