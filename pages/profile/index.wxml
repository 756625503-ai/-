<view class="profile-page">
  <view class="profile-list">
    <view
      class="profile-row"
      wx:for="{{profiles}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openProfile"
    >
      <view class="check-wrap" data-id="{{item.id}}" catchtap="selectProfile">
        <view class="check-box {{activeProfileId === item.id ? 'check-active' : ''}}">
          <text wx:if="{{activeProfileId === item.id}}" class="check-mark">✓</text>
        </view>
      </view>

      <view class="profile-main">
        <view class="name-line">
          <text class="person-name">{{item.displayName}}</text>
          <text class="person-location">（{{item.locationText}}）</text>
        </view>
        <view class="birth-line">
          <text class="gender-dot {{item.gender === '男' ? 'gender-male' : 'gender-female'}}">{{item.genderIcon}}</text>
          <text class="birth-text">{{item.birthText}}</text>
        </view>
      </view>

      <view class="open-icon">
        <text>↗</text>
      </view>
    </view>
  </view>

  <view class="list-footer">总档案：{{profiles.length}} 个</view>

  <button class="float-add" bindtap="addProfile">+</button>
</view>
