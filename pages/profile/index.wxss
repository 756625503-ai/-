.profile-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #efefef;
}

.profile-list {
  padding-top: 12rpx;
  background: #efefef;
}

.profile-swipe {
  position: relative;
  min-height: 160rpx;
  margin: 0 28rpx 18rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #b42318;
}

.profile-row {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 86rpx 1fr 88rpx;
  min-height: 160rpx;
  align-items: center;
  border: 1rpx solid #dfe8ea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(41, 75, 84, 0.06);
  transition: transform 220ms ease-out;
}

.profile-row-revealed {
  transform: translateX(-144rpx);
}

.profile-delete {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
  display: flex;
  width: 144rpx;
  height: 100%;
  min-height: 160rpx;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  color: #ffffff;
  background: #b42318;
  font-size: 28rpx;
  font-weight: 800;
}

.profile-delete::after {
  border: 0;
}

.check-wrap {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.check-box {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #b8d6de;
  border-radius: 50%;
  color: #ffffff;
}

.check-active {
  border-color: #72b0be;
  background: #72b0be;
}

.check-mark {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-main {
  min-width: 0;
  padding: 26rpx 0;
}

.name-line,
.birth-line {
  display: flex;
  min-width: 0;
  align-items: center;
}

.name-line {
  margin-bottom: 18rpx;
}

.person-name {
  flex: 0 1 auto;
  max-width: 220rpx;
  overflow: hidden;
  color: #1d2b3a;
  font-size: 34rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-location {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #71858b;
  font-size: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-dot {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.gender-male {
  color: #315f6a;
  background: #cde9f2;
}

.gender-female {
  color: #355d3f;
  background: #d6ebb4;
}

.birth-text {
  min-width: 0;
  overflow: hidden;
  color: #71858b;
  font-size: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.open-icon {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #5b8792;
  font-size: 42rpx;
  font-weight: 700;
}

.list-footer {
  margin-top: 80rpx;
  color: #8b8d91;
  font-size: 32rpx;
  text-align: center;
}

.float-add {
  position: fixed;
  right: 40rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  color: #ffffff;
  background: #72b0be;
  font-size: 72rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 14rpx 30rpx rgba(67, 119, 130, 0.22);
}
