.profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-name,
.profile-meta {
  display: block;
}

.profile-name {
  color: #101828;
  font-size: 38rpx;
  font-weight: 800;
}

.profile-meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
}
