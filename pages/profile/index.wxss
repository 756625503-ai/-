.profile-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #f7f9fb;
}

.profile-list {
  padding-top: 12rpx;
  background: #f7f9fb;
}

.profile-row {
  display: grid;
  grid-template-columns: 86rpx 1fr 88rpx;
  min-height: 160rpx;
  align-items: center;
  margin: 0 24rpx 18rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.04);
}

.check-wrap {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.check-box {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #b6b8bb;
  border-radius: 4rpx;
  color: #ffffff;
}

.check-active {
  border-color: #147d7e;
  background: #147d7e;
}

.check-mark {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-main {
  min-width: 0;
  padding: 26rpx 0;
}

.name-line,
.birth-line {
  display: flex;
  min-width: 0;
  align-items: center;
}

.name-line {
  margin-bottom: 18rpx;
}

.person-name {
  flex: 0 1 auto;
  max-width: 220rpx;
  overflow: hidden;
  color: #333333;
  font-size: 34rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-location {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #8b8d91;
  font-size: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-dot {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.gender-male {
  background: #8da7f7;
}

.gender-female {
  background: #ff8fa3;
}

.birth-text {
  min-width: 0;
  overflow: hidden;
  color: #b8babd;
  font-size: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.open-icon {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #7d7f83;
  font-size: 42rpx;
  font-weight: 700;
}

.list-footer {
  margin-top: 80rpx;
  color: #8b8d91;
  font-size: 32rpx;
  text-align: center;
}

.float-add {
  position: fixed;
  right: 40rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  color: #ffffff;
  background: #147d7e;
  font-size: 72rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 14rpx 30rpx rgba(20, 125, 126, 0.26);
}
