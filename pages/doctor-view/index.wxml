<view class="page safe-bottom">
  <view class="summary-head">
    <view>
      <text class="summary-title">{{profile.name || '就诊摘要'}}</text>
      <text class="summary-meta">{{profile.gender || '性别未填'}} · {{profile.birthday || '出生日期未填'}} · {{profile.bloodType || '血型未填'}}</text>
    </view>
    <button class="copy-button" bindtap="copySummary">复制</button>
  </view>

  <view class="alert-band">
    <text class="alert-label">过敏史</text>
    <text class="alert-text">{{profile.allergies || '未填写'}}</text>
  </view>

  <view class="info-grid">
    <view class="info-card">
      <text class="info-label">既往病史</text>
      <text class="info-text">{{profile.medicalHistory || '未填写'}}</text>
    </view>
    <view class="info-card">
      <text class="info-label">长期用药</text>
      <text class="info-text">{{profile.longTermMedication || '未填写'}}</text>
    </view>
    <view class="info-card">
      <text class="info-label">家族病史</text>
      <text class="info-text">{{profile.familyHistory || '未填写'}}</text>
    </view>
    <view class="info-card">
      <text class="info-label">紧急联系人</text>
      <text class="info-text">{{profile.emergencyContact || '未填写'}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">近期记录</text>
    <block wx:if="{{recentRecords.length}}">
      <view class="timeline-item" wx:for="{{recentRecords}}" wx:key="id">
        <view class="timeline-date">
          <text>{{item.displayDate}}</text>
          <text class="pill {{item.type === '处方' ? 'pill-amber' : item.type === '体检' ? 'pill-green' : ''}}">{{item.type}}</text>
        </view>
        <view class="timeline-body">
          <text class="timeline-title">{{item.displayTitle}}</text>
          <text class="timeline-meta">{{item.hospital || '未填写医院'}} {{item.department || ''}}</text>
          <text wx:if="{{item.diagnosis}}" class="timeline-text">诊断：{{item.diagnosis}}</text>
          <text wx:if="{{item.medicines}}" class="timeline-text">用药：{{item.medicines}}</text>
          <text wx:if="{{item.advice}}" class="timeline-text">建议：{{item.advice}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无记录</view>
  </view>
</view>
