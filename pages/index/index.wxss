.hero {
  display: flex;
  min-height: 220rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e 0%, #175cd3 100%);
}

.eyebrow,
.hero-title {
  display: block;
}

.eyebrow {
  margin-bottom: 18rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

.hero-title {
  max-width: 430rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.22;
}

.hero-action {
  flex: 0 0 auto;
  min-width: 164rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
  color: #063a3b;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.stat-card {
  min-height: 132rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  min-height: 42rpx;
  color: #101828;
  font-size: 30rpx;
  font-weight: 800;
  word-break: break-all;
}

.stat-label {
  margin-top: 12rpx;
  color: #667085;
  font-size: 23rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.link-button {
  min-height: 52rpx;
  padding: 0 10rpx;
  color: #175cd3;
  background: transparent;
  font-size: 26rpx;
  font-weight: 700;
}

.record-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-date {
  color: #667085;
  font-size: 24rpx;
}

.record-title {
  display: block;
  margin-top: 18rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.record-meta {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 25rpx;
}
