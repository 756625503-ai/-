.compare-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 34rpx;
  background: #efefef;
}

.compare-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #b9dce5;
  border-radius: 16rpx;
  color: #1d2b3a;
  background: #cde9f2;
  box-shadow: 0 8rpx 20rpx rgba(67, 119, 130, 0.08);
}

.hero-kicker,
.hero-name,
.hero-count,
.panel-title,
.panel-meta,
.report-year,
.report-title,
.report-meta,
.report-files,
.report-metrics,
.head-year,
.head-title {
  display: block;
}

.hero-kicker {
  color: #5b7880;
  font-size: 26rpx;
  font-weight: 700;
}

.hero-name {
  margin-top: 8rpx;
  color: #1d2b3a;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-count {
  min-width: 126rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #355d3f;
  background: #d6ebb4;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.member-scroll,
.report-scroll,
.compare-table-scroll {
  width: 100%;
  white-space: nowrap;
}

.member-scroll {
  margin-top: 22rpx;
}

.member-row,
.report-row {
  display: flex;
  gap: 14rpx;
}

.member-chip {
  display: inline-flex;
  min-width: 104rpx;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border: 1rpx solid #d3e0e3;
  border-radius: 999rpx;
  color: #405961;
  background: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.member-active {
  color: #173f48;
  background: #72b0be;
  border-color: #72b0be;
}

.select-panel,
.compare-section,
.empty-compare {
  margin-top: 24rpx;
  border: 1rpx solid #dfe8ea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(41, 75, 84, 0.06);
}

.select-panel {
  padding: 24rpx 0 26rpx;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 24rpx;
}

.panel-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
}

.panel-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.add-record-btn {
  width: 104rpx;
  min-width: 104rpx;
  min-height: 58rpx;
  border-radius: 999rpx;
  color: #315f6a;
  background: #cde9f2;
  font-size: 26rpx;
  font-weight: 800;
}

.report-scroll {
  margin-top: 22rpx;
}

.report-row {
  padding: 0 24rpx;
}

.report-card {
  flex: 0 0 auto;
  width: 324rpx;
  min-height: 230rpx;
  padding: 22rpx;
  border: 2rpx solid #dfe8ea;
  border-radius: 16rpx;
  background: #ffffff;
}

.report-selected {
  border-color: #a7cb83;
  background: #f2f9e7;
  box-shadow: 0 10rpx 22rpx rgba(98, 133, 66, 0.12);
}

.report-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.report-year {
  color: #4b858f;
  font-size: 36rpx;
  font-weight: 900;
}

.report-check {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #475467;
  background: #f2f4f7;
  font-size: 22rpx;
  font-weight: 800;
}

.report-selected .report-check {
  color: #355d3f;
  background: #d6ebb4;
}

.report-title {
  margin-top: 18rpx;
  overflow: hidden;
  color: #101828;
  font-size: 29rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-meta,
.report-files,
.report-metrics {
  overflow: hidden;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-meta {
  margin-top: 10rpx;
}

.report-files {
  margin-top: 12rpx;
  color: #72b0be;
  font-weight: 700;
}

.report-metrics {
  margin-top: 8rpx;
  color: #4b858f;
  font-weight: 800;
}

.compare-section {
  padding: 0 0 24rpx;
  overflow: hidden;
}

.compare-table {
  display: grid;
  min-width: 900rpx;
}

.compare-table.columns-2 {
  min-width: 860rpx;
}

.compare-table.columns-3 {
  min-width: 1120rpx;
}

.table-row {
  display: grid;
  grid-template-columns: 200rpx repeat(3, 1fr);
  border-bottom: 1rpx solid #eef2f6;
}

.compare-table.columns-2 .table-row {
  grid-template-columns: 200rpx repeat(2, 1fr);
}

.table-head {
  background: #cde9f2;
}

.table-label,
.table-cell {
  min-height: 96rpx;
  padding: 24rpx 22rpx;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.55;
  white-space: normal;
  word-break: break-all;
}

.table-label {
  color: #101828;
  background: #efefef;
  font-weight: 800;
}

.head-cell {
  color: #101828;
}

.head-year {
  color: #4b858f;
  font-size: 30rpx;
  font-weight: 900;
}

.head-title {
  margin-top: 6rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 24rpx 24rpx 0;
}

.detail-button {
  min-height: 68rpx;
  border-radius: 12rpx;
  color: #315f6a;
  background: #cde9f2;
  font-size: 25rpx;
  font-weight: 800;
}

.empty-compare {
  padding: 44rpx 24rpx;
  color: #98a2b3;
  font-size: 28rpx;
  text-align: center;
}

.empty-title,
.empty-note {
  display: block;
}

.empty-title {
  color: #344054;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-note {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}
